# Local: browser talks to Express on this machine.
# Leave API_REWRITE_ORIGIN unset so Next.js does not rewrite /api or /health.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Shared cloud (set in the Vercel project mycareflow-dev, not in a committed .env):
# NEXT_PUBLIC_API_URL=https://mycareflow-dev.vercel.app
# API_REWRITE_ORIGIN=https://careflow-api-dev.onrender.com
#
# API_REWRITE_ORIGIN is server-only (not NEXT_PUBLIC_*). When set, Next.js
# rewrites /api/* and /health/* to that origin. See docs/environments.md.
