# Local machine overrides — copy to .env.local and edit database credentials.
# Always loaded last (wins over .env and .env.${APP_ENV}).
# Do not commit .env.local.

NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
DATABASE_URL=mysql://ubp:ubp_secret@localhost:3306/business_platform
REDIS_URL=redis://localhost:6379

# LOCAL DEVELOPMENT ONLY — do not use in production
JWT_SECRET=careflow_local_dev_jwt_7f3a9e2b1c8d4f6a0e5b9c3d7f1a4e8b2c6d0f4a8e1b5c9d3f7a0e4b8c2d6f1a5e9
PHI_ENCRYPTION_KEY=careflow_local_phi_key_4e8b1c9d3f7a0e5b2c6d0f4a8e1b5c9d3f7a0e4b8c2d6f1a5e9b3c7f1a4e8b2c6d0f4

JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
