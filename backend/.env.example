# Base template — copy to .env, .env.local, or .env.development as needed.
# Load order (later wins): .env → .env.${APP_ENV} → .env.local
#
# Local (recommended):
#   cp .env.example .env.local
#   # edit .env.local for localhost MySQL/Redis
#   npm run dev
#
# Shared careflow-dev (optional):
#   cp .env.development.example .env.development
#   # fill Aiven/Upstash secrets — never commit
#   set APP_ENV=development   # PowerShell: $env:APP_ENV="development"
#   npm run dev
#
# Hosted (Render): set env vars in the dashboard; files are optional.

NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
# Optional extra CORS origins, comma-separated (e.g. Vercel preview URLs).
# WEB_URL is always allowed. Localhost:3000 is always allowed.
# CORS_ORIGINS=https://mycareflow-dev-git-feature.vercel.app

DATABASE_URL=mysql://ubp:ubp_secret@localhost:3306/business_platform
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=business_platform
MYSQL_USER=ubp
MYSQL_PASSWORD=ubp_secret
REDIS_URL=redis://localhost:6379
# JWT_SECRET — set in .env.local for local dev (see .env.local.example). Required on Render (never use local dev secret).
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Optional: PEM or file path for cloud MySQL TLS verification in production
# DATABASE_SSL_CA=
# Phase 4 PHI field encryption (optional locally; see .env.local.example)
# PHI_ENCRYPTION_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
EMAIL_PROVIDER=console
