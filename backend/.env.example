NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
# Optional extra CORS origins, comma-separated (e.g. Vercel preview URLs).
# WEB_URL is always allowed. Localhost:3000 is always allowed.
# CORS_ORIGINS=https://mycareflow-dev-git-feature.vercel.app
#
# Shared cloud (set on Render, not in a committed .env):
# NODE_ENV=production
# WEB_URL=https://mycareflow-dev.vercel.app
# PORT is injected by Render; do not set API_PORT there.
DATABASE_URL=mysql://ubp:ubp_secret@localhost:3306/business_platform
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=business_platform
MYSQL_USER=ubp
MYSQL_PASSWORD=ubp_secret
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
EMAIL_PROVIDER=console
