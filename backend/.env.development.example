# Shared careflow-dev — copy to .env.development and fill secrets.
# Usage: APP_ENV=development npm run dev
# (.env.local still wins if present — remove or empty overlapping keys for pure remote.)
# Do not commit .env.development.

NODE_ENV=development
API_PORT=3001
WEB_URL=https://mycareflow-dev.vercel.app
# CORS_ORIGINS=

DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/careflow-dev
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JWT_SECRET=replace-with-shared-dev-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
EMAIL_PROVIDER=console
